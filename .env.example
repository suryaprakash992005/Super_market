# Bharathi Store Environment Variables
# Copy to .env.local to connect to your real Supabase instance and Cloudflare R2 bucket.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Bharathi Store
VITE_R2_PUBLIC_URL=https://media.bharathistore.com
VITE_STORE_PHONE=+91 98421 23456
VITE_STORE_ADDRESS=42, Bharathi Supermarket Complex, Main Road, Madurai, Tamil Nadu 625001

# NOTE: The following secrets are SERVER-SIDE ONLY and must NEVER be exposed in frontend:
# SUPABASE_SERVICE_ROLE_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# RAZORPAY_KEY_SECRET=
# PAYTM_MERCHANT_KEY=
# PHONEPE_SALT_KEY=
